MYSQL_DATABASE=tourmate
MYSQL_USER=tourmate
MYSQL_PASSWORD=tourmate_local
MYSQL_ROOT_PASSWORD=root_local
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Optional: enables live Geoapify search. Keep this backend-only.
GEOAPIFY_API_KEY=

# Original project's travel providers. Subscribe to the matching products on RapidAPI.
RAPIDAPI_KEY=
RAPIDAPI_TRAVEL_HOST=travel-advisor.p.rapidapi.com
RAPIDAPI_BOOKING_HOST=booking-com18.p.rapidapi.com

# Spring AI local Ollama (model must be pulled separately)
OLLAMA_MODEL=qwen3:8b
# Docker backend accesses Ollama on the host
OLLAMA_BASE_URL=http://host.docker.internal:11434
